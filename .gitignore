.env
.env.*
!.env.example

# ── OS / editor artifacts ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.bak
*.swp
*~

# ── TypeScript build info (local caches) ───────────────────────────────────────
*.tsbuildinfo

# ── Claude Code ────────────────────────────────────────────────────────────────
.claude/

# ── Local test fixtures / sample projects (not part of the app) ────────────────
test_project/
